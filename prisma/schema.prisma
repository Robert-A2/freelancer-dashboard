generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Stripe Connect — lets a freelancer receive milestone payments directly
  // into their own Stripe account. Both nullable/defaulted so every existing
  // user row is valid the moment this column exists; no backfill required.
  stripeAccountId      String? @unique
  stripeAccountEnabled Boolean @default(false)

  // ── Financial profile ──────────────────────────────────────────────────────
  // Drives the Financial Reserve Engine (src/lib/reserve-engine/) — none of
  // this is derivable from transaction history, it's regulatory/personal
  // fact only the freelancer knows. All nullable: an incomplete profile still
  // gets a clearly-labeled generic estimate, never a silent guess presented
  // as precise. Completing these lets the country-specific rule set (only
  // France implemented so far) compute a real breakdown instead.
  country                  String? // ISO 3166-1 alpha-2, e.g. "FR"
  businessLegalStatus      String? // "micro_entrepreneur" | "other" | "unsure"
  // Country-specific key. France micro-entrepreneur: "bnc_liberal" |
  // "bic_service_commercial" | "bic_service_artisan" | "bic_sales" |
  // "cipav_liberal" | "mixed" | "unsure" — five categories, not three,
  // because BIC commercial vs artisan services carry different CFP rates
  // (Tax & Contributions spec section 4).
  activityType             String?
  vatStatus                String? // "exempt" | "registered" | "unknown"
  manualReservePctOverride Decimal? @db.Decimal(5, 2) // optional override of the total reserve %, usable any time, especially before the profile is complete

  // ── France micro-entrepreneur tax profile (Tax & Contributions spec) ────────
  // Extends the financial profile above rather than a separate table — there
  // is exactly one tax profile per user; onboarding writes these same fields,
  // Settings edits them later. Every field stores the user's raw declared
  // fact, never a pre-computed rate, so calculateFrenchMicroReserve() can
  // re-derive the correct percentage as rates or ACRE eligibility change over
  // time (spec section 19).
  versementLiberatoireStatus String? // "yes" | "no" | "unknown" — flat-rate income tax scheme (spec section 6)
  acreStatus                 String? // "yes" | "no" | "unknown" — ACRE reduced-contribution eligibility (spec section 8)
  activityStartDate          DateTime? // drives ACRE's date-versioned reduced rate and its expiry (spec sections 9-11)
  defaultVatRate             Decimal?  @db.Decimal(4, 2) // e.g. 20.00 — only meaningful when vatStatus === "registered"; per-payment override allowed later
  urssafFrequency            String? // "monthly" | "quarterly" | "unknown" — which contribution period the reserve belongs to (spec section 16)
  // A user-declared flat euro figure to set aside for taxes — distinct from
  // manualReservePctOverride above, which overrides the computed *rate* the
  // Reserve Engine applies to income. This is the manual-entry user's own
  // number, shown as-is, never derived from or reconciled with that engine.
  manualTaxReserveAmount   Decimal? @db.Decimal(12, 2)
  // Whether the user keeps a genuinely separate bank account for their
  // freelance activity, or one shared account for both business and
  // personal money (onboarding's money-separation question) — null = never
  // asked (legacy). This is what makes the Dashboard's Business/Personal/All
  // account filter actually show different numbers instead of the same
  // figures copied into every view: without it there was only ever one
  // undifferentiated "current cash" and one "spending estimate" no matter
  // which tab was selected.
  accountsSeparated        Boolean?
  // Replaces the old single manualSpendingEstimate — a freelancer's business
  // running costs and their own personal living-expense draw are different
  // numbers with different implications (one is what the business needs to
  // keep operating, the other is what the owner needs to pay themselves),
  // so onboarding now asks for both separately rather than one vague
  // "average expense" silently reused for both meanings. Powers Estimated
  // Runway (src/lib/data-maturity.ts) per account/view until real observed
  // history exists to calculate it instead. Never treated as actual
  // history: always labeled "you told us this" wherever shown (spec
  // section 28).
  businessSpendingEstimate Decimal? @db.Decimal(12, 2)
  personalSpendingEstimate Decimal? @db.Decimal(12, 2)
  // "How much runway do you want to protect?" (Money Intelligence spec
  // section 11) — null = not configured, so Safe To Use is never computed
  // and silently presented as universally correct. When set, protectedBuffer
  // = spendingBasis × safetyBufferMonths, in src/lib/money-breakdown.ts.
  safetyBufferMonths       Decimal? @db.Decimal(4, 2)

  // ── VAT / invoicing identity ────────────────────────────────────────────────
  // vatStatus === "registered" doubles as the "I am registered for VAT/GST/
  // Sales tax" toggle: charging VAT is illegal for anyone not actually
  // registered, so every VAT field on an invoice is driven off this single
  // flag rather than a separate boolean that could drift out of sync with it.
  vatNumber    String? // e.g. "GB123456789" — shown on invoices only when vatStatus === "registered"
  businessName String? // invoice issuer name, e.g. "DESIGNSTUDIO LTD." — falls back to fullName when unset

  // ── Client-facing branding ─────────────────────────────────────────────────
  // Applied to the public Pay page — what a client actually sees when sent a
  // payment link. All optional: an unbranded page already looks calm and
  // professional (see /pay/[token]), this only ever adds to it, never blocks it.
  brandLogoUrl     String? // public Supabase Storage URL, shown above the client name
  brandAccentColor String? // hex, e.g. "#2FA393" — replaces the default teal accent
  brandFont        String? // key into src/lib/brand-font-options.ts, e.g. "inter"

  accounts               Account[]
  csvImports             CsvImport[]
  transactions           Transaction[]
  monthlyAnalytics       MonthlyAnalytics[]
  forecasts              Forecast[]
  categoryRules          CategoryRule[]
  categoryCorrections    CategoryCorrection[]
  userIntentRules        UserIntentRule[]
  payers                 Payer[]
  projects               Project[]
  milestones             Milestone[]
  cashBalanceCheckpoints CashBalanceCheckpoint[]
  recurringExpenses      RecurringExpense[]
  expectedPayments       ExpectedPayment[]

  @@map("users")
}

// ── Account identity ─────────────────────────────────────────────────────────
// Every CSV import is linked to an account so each transaction carries its
// original bank/account identity. Deduplication is per-account: the same
// transaction can legitimately appear in two different accounts (e.g. a salary
// payment visible in both the employer's reference export and the employee's
// bank statement), but re-uploading the same file to the same account is safe.

enum AccountType {
  personal_checking
  personal_savings
  business_checking
  business_savings
  investment
  credit_card
  other
}

model Account {
  id          String      @id @default(uuid())
  userId      String
  name        String // user-given: "Revolut Business", "BNP Courant"
  institution String? // auto-detected from CSV header: "Revolut", "BNP"
  accountType AccountType @default(personal_checking)
  currency    String      @default("EUR")
  color       String? // hex accent for UI, e.g. "#3AB5A0"
  isArchived  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  csvImports        CsvImport[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
  @@index([userId])
  @@map("accounts")
}

// ── Payer Identity ───────────────────────────────────────────────────────────
// The payer identity system answers "who sent this money?" for every incoming
// transaction. Revenue confidence is derived from payer behaviour (payment
// frequency, amount consistency, cadence) — not from transaction keywords alone.
//
// PayerType classifies the nature of the entity sending money:
//   - client / employer / platform → potential revenue sources
//   - bank / government / refund_source → excluded from revenue (by definition)
//   - unknown → accumulates evidence; confidence rises with each payment
//
// Revenue tiers:
//   HIGH confidence  → verifiedRevenue  (3+ payments with pattern, OR 6+ payments)
//   MEDIUM confidence → likelyRevenue   (2+ payments from same payer)
//   LOW confidence   → reviewRevenue    (single payment, no pattern)
//   NONE (bank/gov)  → excluded from all revenue figures

enum PayerType {
  client // confirmed revenue source — freelance client
  employer // salary / employment — recurring fixed payroll
  platform // Upwork, Fiverr, Stripe, PayPal, Malt, etc.
  bank // financial institution transfers — NOT revenue
  government // tax authorities, social benefits — NOT revenue
  refund_source // merchant / purchase reversal — NOT revenue
  unknown // unclassified — confidence determined by payment history
}

model Payer {
  id            String    @id @default(uuid())
  userId        String
  canonicalName String // display name set on first encounter, e.g. "Acme Sarl"
  displayName   String? // user-set preferred name (overrides canonicalName in UI)
  payerType     PayerType @default(unknown)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliases      PayerAlias[]
  transactions Transaction[]

  @@unique([userId, canonicalName])
  @@index([userId, payerType])
  @@map("payers")
}

model PayerAlias {
  id        String   @id @default(uuid())
  payerId   String
  rawText   String // exact text extracted from bank description
  matchKey  String // normalized for dedup (no legal suffixes, lowercase, accent-free)
  hitCount  Int      @default(1)
  createdAt DateTime @default(now())

  payer Payer @relation(fields: [payerId], references: [id], onDelete: Cascade)

  @@unique([payerId, matchKey])
  @@index([matchKey])
  @@map("payer_aliases")
}

model CsvImport {
  id            String   @id @default(uuid())
  userId        String
  accountId     String?
  fileName      String
  status        String   @default("pending")
  totalRows     Int      @default(0)
  importedRows  Int      @default(0)
  duplicateRows Int      @default(0)
  importedAt    DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@map("csv_imports")
}

model Transaction {
  id                 String   @id @default(uuid())
  userId             String
  csvImportId        String?
  accountId          String?
  payerId            String? // resolved payer — set by payer engine after import
  merchantId         String? // resolved merchant identity — set by merchant-intelligence pipeline after import
  // Set only on rows materialized by the recurring-expense sync engine (see
  // src/lib/recurring-expense-engine.ts) — lets that engine know which months
  // are already covered without re-deriving it from description/amount/date.
  recurringExpenseId String?
  transactionDate    DateTime
  description        String
  amount             Decimal  @db.Decimal(12, 2)
  transactionType    String
  category           String   @default("uncategorized")
  categoryConfidence String   @default("medium")
  categorySource     String?
  // Human-readable explanation, set only when categorySource is "intelligence"
  // (see computeDecisionScore()'s `reason` field) — the Decision Engine's own
  // account of which signals produced this category. Null for every other
  // source (static/keyword matches don't have one to give).
  categoryReason     String?
  sourceFile         String?
  // ── Financial intent ─────────────────────────────────────────────────────
  // Orthogonal to transactionType (which determines analytics bucketing).
  // intent says WHY the money moved; transactionType says HOW it's counted.
  // e.g. transactionType:"transfer" + intent:"family_support" = WorldRemit send.
  intent             String? // e.g. "family_support", "investment", "business_expense"
  intentConfidence   String? // "high" | "medium" | "low"
  intentSource       String? // "user" | "global" | "inferred"
  needsReview        Boolean  @default(false)
  createdAt          DateTime @default(now())
  // Audit snapshot of the France tax calculation used for THIS payment at
  // the moment it was recorded (Tax & Contributions spec section 33) — the
  // rates/activity/ACRE status that applied then, not a live pointer to the
  // user's current profile. A later Settings change must never silently
  // rewrite what this transaction's reserve was calculated as (spec section
  // 32). Null for expenses and any income not run through the France engine
  // (e.g. CSV-imported rows, or a non-France/unsupported-status profile).
  taxReserveSnapshot Json?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  csvImport        CsvImport?        @relation(fields: [csvImportId], references: [id], onDelete: SetNull)
  account          Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payer            Payer?            @relation(fields: [payerId], references: [id], onDelete: SetNull)
  merchant         Merchant?         @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  // Back-relation only — the foreign key lives on Milestone.transactionId.
  // Set once a Stripe payment (or a matched CSV import row) clears this milestone.
  milestone        Milestone?
  // Back-relation only — the foreign key lives on ExpectedPayment.receivedTransactionId.
  expectedPayment  ExpectedPayment?

  // Deduplication is per-account when an account is set, cross-account otherwise.
  // Two partial unique indexes (created via raw SQL after prisma db push) enforce this:
  //   CREATE UNIQUE INDEX tx_dedup_with_account ON transactions(userId, accountId, transactionDate, description, amount) WHERE accountId IS NOT NULL;
  //   CREATE UNIQUE INDEX tx_dedup_no_account   ON transactions(userId, transactionDate, description, amount)            WHERE accountId IS NULL;
  // Application-level dedup (upload API) mirrors this logic so no duplicate rows are
  // ever sent to createMany, keeping the insert path simple and fast.
  @@index([userId, transactionDate])
  @@index([userId, transactionType])
  @@index([userId, transactionDate, transactionType])
  @@index([userId, needsReview])
  @@index([userId, accountId])
  @@index([userId, payerId])
  @@index([userId, merchantId])
  @@index([userId, recurringExpenseId])
  @@map("transactions")
}

model MonthlyAnalytics {
  id              String   @id @default(uuid())
  userId          String
  month           Int
  year            Int
  // ── Bank cashflow (raw) ───────────────────────────────────────────────────
  totalIncome     Decimal  @default(0) @db.Decimal(12, 2) // all positive inflows
  totalExpenses   Decimal  @default(0) @db.Decimal(12, 2)
  totalSavings    Decimal  @default(0) @db.Decimal(12, 2)
  netCashflow     Decimal  @default(0) @db.Decimal(12, 2) // totalIncome - totalExpenses
  // ── Payer-derived revenue tiers ───────────────────────────────────────────
  // Computed by payer-engine after each import. These answer the question
  // "how much was actually earned from clients?" — not "how much came in?"
  verifiedRevenue Decimal  @default(0) @db.Decimal(12, 2) // HIGH confidence payers
  likelyRevenue   Decimal  @default(0) @db.Decimal(12, 2) // MEDIUM confidence payers
  reviewRevenue   Decimal  @default(0) @db.Decimal(12, 2) // LOW confidence — Needs Review
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId, year, month])
  @@map("monthly_analytics")
}

model CategoryRule {
  id          String   @id @default(uuid())
  userId      String
  merchantKey String
  category    String
  hitCount    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@index([userId, category])
  @@map("category_rules")
}

model CategoryCorrection {
  id               String   @id @default(uuid())
  userId           String
  transactionId    String
  description      String
  fromCategory     String
  toCategory       String
  appliedToSimilar Boolean  @default(false)
  affectedCount    Int      @default(1)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, description])
  @@map("category_corrections")
}

model Forecast {
  id                String   @id @default(uuid())
  userId            String
  projectedIncome   Decimal  @db.Decimal(12, 2)
  projectedExpenses Decimal  @db.Decimal(12, 2)
  projectedSavings  Decimal  @db.Decimal(12, 2)
  projectedCashflow Decimal  @db.Decimal(12, 2)
  forecastPeriod    String
  generatedAt       DateTime @default(now())
  intentBreakdown   Json? // intent-based projections; null when coverage < 80%

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, forecastPeriod])
  @@index([userId])
  @@map("forecasts")
}

// ── Merchant Intelligence ────────────────────────────────────────────────
// Global identity — no userId. One canonical row per real-world merchant,
// shared across every user: a payer's trustworthiness is personal ("who
// pays me" — see Payer/PayerAlias below), but a merchant's identity isn't
// ("Adobe" is the same company for every user who pays it). Still the
// database-backed supplement to the static merchant packs in
// src/lib/categorization/packs/ — additive layer merged into the engine's
// matching waterfall via buildMerchantIndex(); the static packs are checked
// first and this table never overrides that proven matching order. Lets
// merchants be added/corrected without a code deploy, and — new — gives
// every merchant a real identity that accumulates knowledge over time
// (see MerchantFeedback) instead of being just a keyword row.
model Merchant {
  id              String @id @default(uuid())
  canonicalName   String // display name, e.g. "Adobe"
  normalizedKey   String // stable identity key from normalizeMatchKey(), e.g. "adobe"
  transactionType String @default("expense") // income | expense | savings | transfer

  // ── Categorization (existing behavior, unchanged) ──────────────────────
  category    String // e.g. "food", "taxes", "freelance platform"
  subcategory String? // e.g. "creative software" — unpopulated at launch
  confidence  String  @default("high") // high | medium | low — coarse tier; this (not globalConfidence) drives the matching waterfall bucket

  // ── Rich identity — vision fields, populated incrementally ─────────────
  industry              String?
  businessType          String? // e.g. "saas" | "retail" | "marketplace" | "utility" | "government"
  parentCompany         String?
  website               String?
  logoUrl               String?
  recurringIndicator    String?  @default("unknown") // "always" | "sometimes" | "never" | "unknown"
  taxClassificationHint String? // advisory only — never used for real tax filing
  businessFunction      String? // short free-text, e.g. "creative software subscription"
  knownLanguages        String[] @default([])
  metadata              Json? // open-ended catch-all so future fields don't need another migration

  // ── Numeric confidence engine ────────────────────────────────────────────
  globalConfidence    Int   @default(0) // 0-100. Reporting/UI input only in v1 — does NOT feed the matching waterfall.
  confidenceBreakdown Json? // stored component signals for transparency/debugging
  popularity          Int   @default(0) // global hit counter, incremented on every match

  // ── Provenance / future AI seam ──────────────────────────────────────────
  source String @default("static-pack")
  // "static-pack" | "seed-curated" | "db-manual" | "user-derived" | "cross-user-derived" | "ai-assisted"
  // "ai-assisted" is reserved for a future fast-follow — no v1 code path writes it.

  country   String? // ISO 3166-1 alpha-2, null = international
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases      MerchantAlias[]
  transactions Transaction[]
  feedback     MerchantFeedback[]

  @@unique([normalizedKey, transactionType])
  @@index([country])
  @@index([category])
  @@index([source])
  @@map("merchants")
}

model MerchantAlias {
  id         String   @id @default(uuid())
  merchantId String
  keyword    String   @unique // alternate lowercase match string
  hitCount   Int      @default(1) // popularity signal at the alias level
  source     String   @default("static-pack") // same enum as Merchant.source
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("merchant_aliases")
}

// Anonymized cross-user learning signal — the "10,000 users classify Canva
// as Marketing Software, global confidence increases" mechanism. Aggregate
// counts ONLY. Hard privacy invariant: this table must never gain a userId,
// description, or amount column — that's what keeps it safe to aggregate
// across tenants in a multi-tenant app holding private financial data.
// Written only from the recategorize route, gated to at most one increment
// per correction event (see recategorize/route.ts) so one user's repeated
// corrections can't skew the cross-user signal.
model MerchantFeedback {
  id            String   @id @default(uuid())
  merchantId    String
  category      String
  agreeCount    Int      @default(0)
  disagreeCount Int      @default(0)
  updatedAt     DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, category])
  @@map("merchant_feedback")
}

// ── Intent classification infrastructure ────────────────────────────────────
// Parallel to the category system but answers "WHY did money move" not
// "WHAT was bought". intent is never used in MonthlyAnalytics aggregation —
// transactionType governs that. intent powers insight copy, spending stories,
// and the "needs review" queue for ambiguous transfers.

// Global defaults — seeded by maintainers, no user ownership.
// Static rules in src/lib/intent-engine.ts take priority over these; this
// table exists for runtime additions without a code deploy.
model IntentRule {
  id          String   @id @default(uuid())
  merchantKey String   @unique
  intent      String
  confidence  String   @default("high")
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([intent])
  @@map("intent_rules")
}

// Per-user intent overrides — highest priority, survives re-imports.
model UserIntentRule {
  id          String   @id @default(uuid())
  userId      String
  merchantKey String
  intent      String
  source      String   @default("user") // "user" | "propagated"
  hitCount    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@index([userId, intent])
  @@map("user_intent_rules")
}

// Global, cross-user signal: every transaction that falls through to
// "uncategorized" is aggregated here by normalized merchant key, giving the
// maintainer a worklist for the next seed-data update.
model UncategorizedMerchantReport {
  id                String   @id @default(uuid())
  merchantKey       String   @unique // normalizeMerchantKey(description)
  sampleDescription String
  occurrenceCount   Int      @default(1)
  status            String   @default("new") // new | reviewed | resolved | ignored
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, occurrenceCount])
  @@map("uncategorized_merchant_reports")
}

// ── Project Milestone Tracker ────────────────────────────────────────────────
// Not an invoicing tool: no PDFs, no line items, no "Accounts Receivable"
// screen. A Project is three fields (client, project, total value) split into
// Milestones. Each Milestone gets a payment URL; a confirmed Stripe payment
// writes a real Transaction row (intent: "freelance_income") — the exact same
// row shape the CSV importer produces — so forecast, cashflow, runway, tax
// shield and health score all pick it up automatically with zero new logic.
// A Milestone in "pending"/"sent" state is never counted as real income
// anywhere; it is only ever surfaced as "expected", read separately from
// confirmed money.

enum ProjectStatus {
  active
  completed
  archived
}

// pending  — created, no payment link generated yet
// sent     — payment URL generated/shared with the client
// paid     — Stripe webhook confirmed payment (source of truth: Stripe, not the client)
// overdue  — sent + past dueDate, still unpaid (derived at read time, not stored transition)
// cleared  — the resulting Transaction was later matched to a real bank deposit
//            from a CSV import, confirming the money actually landed
enum MilestoneStatus {
  pending
  sent
  paid
  overdue
  cleared
}

model Project {
  id          String        @id @default(uuid())
  userId      String
  clientName  String
  projectName String
  totalValue  Decimal       @db.Decimal(12, 2)
  currency    String        @default("EUR")
  status      ProjectStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([userId])
  @@map("projects")
}

model Milestone {
  id        String          @id @default(uuid())
  projectId String
  userId    String // denormalized — lets every dashboard query filter by userId alone
  label     String // e.g. "Deposit (50%)", "Final payment"
  amount    Decimal         @db.Decimal(12, 2)
  currency  String          @default("EUR")
  dueDate   DateTime?
  status    MilestoneStatus @default(pending)

  // A project's milestones are created together in one batched insert, so
  // `createdAt` (DB-level `now()`) is identical across all of them — ties
  // that make `orderBy: createdAt` non-deterministic and can silently
  // display "Final payment" before "Deposit". sortOrder is set explicitly
  // from the milestone's position at creation time so display order always
  // matches creation intent.
  sortOrder Int @default(0)

  // Public payment URL identity — a random opaque token, never the row id,
  // so the payment link can be shared without exposing sequential/guessable ids.
  paymentUrlToken String @unique @default(cuid())

  // Sequential per-user invoice number (displayed as "INV-0001") — assigned
  // once at creation from a simple count of the user's prior milestones.
  // Every milestone IS an invoice to a client, so every milestone gets one.
  // Default(0) only exists so this can be added to a table with existing
  // rows; those get backfilled once, every new milestone sets a real value.
  invoiceNumber Int @default(0)

  // ── VAT (set once, at creation, never retroactively recalculated — an
  // issued invoice's tax treatment must stay fixed even if the freelancer's
  // settings change later) ─────────────────────────────────────────────────
  // `amount` above always stays the NET contract value the freelancer
  // actually earns — every existing calculation (runway, expected income,
  // forecast, the Transaction recorded on payment) keeps working unchanged.
  // VAT is purely additive on top, computed only for display and for the
  // actual Stripe charge. null = no VAT (not registered, or registered but
  // this milestone predates the feature).
  vatRatePct      Decimal? @db.Decimal(5, 2)
  // Cross-border B2B reverse charge (client is a business outside the
  // freelancer's country): VAT rate is 0 and a legal note is shown instead
  // of a tax line — flagged separately from a plain 0% rate so the correct
  // wording always shows even if the rate itself happens to be 0 for another reason.
  isReverseCharge Boolean  @default(false)

  // Stripe linkage — set when a Checkout Session is created, confirmed by webhook only.
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?

  // Set once the webhook (or a later CSV match) creates/links the real Transaction —
  // this is the single seam that plugs milestone income into every existing
  // dashboard calculation without duplicating any of their logic.
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([projectId])
  @@map("milestones")
}

// ── Manual transaction entry ─────────────────────────────────────────────────
// Lets a user get value from Nonodia without uploading a CSV first — typing
// in a starting cash balance, known recurring expenses, and expected income
// feeds the exact same Transaction/MonthlyAnalytics pipeline a CSV import
// does (see src/lib/recurring-expense-engine.ts, cash-balance-engine.ts,
// expected-payment-engine.ts). Deliberately separate from Project/Milestone
// (the invoicing feature) — not extended, not reused, per explicit product
// decision.

// Append-only: app code only ever inserts a new row, never updates one — this
// is what makes "Edit balance" an honest adjustment on top of history rather
// than a silent overwrite of it.
model CashBalanceCheckpoint {
  id            String   @id @default(uuid())
  userId        String
  // null = a shared/unified checkpoint, used when User.accountsSeparated is
  // false (or never answered) — the same balance applies to every account
  // filter view, since it genuinely is one pool of money. Set to a real
  // Account id only when accountsSeparated is true, scoping this checkpoint
  // to that one account (Business or Personal) so getCurrentCashPosition()
  // can show a real, different balance per filter tab instead of the same
  // global number everywhere.
  accountId     String?
  amount        Decimal  @db.Decimal(12, 2)
  effectiveDate DateTime @default(now())
  source        String // "manual-entry" | "user-correction"
  note          String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveDate])
  @@index([userId, accountId, effectiveDate])
  @@map("cash_balance_checkpoints")
}

// A declared, known-in-advance monthly expense (rent, a SaaS subscription).
// This is the DECLARED counterpart to forecast-engine.ts's detectRecurringExpenses,
// which statistically INFERS recurrence from >=2 months of transaction history —
// the two are complementary signals, never merged. accountId carries the
// Business/Personal distinction via the existing Account/accountType mechanism,
// not a new flag on Transaction.
model RecurringExpense {
  id           String   @id @default(uuid())
  userId       String
  accountId    String
  merchantName String
  category     String
  amount       Decimal  @db.Decimal(12, 2)
  dayOfMonth   Int // 1-28, clamped to the real length of shorter months
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  generatedTransactions Transaction[]

  @@index([userId, isActive])
  @@map("recurring_expenses")
}

// "Money you expect to receive" — a manual-entry user's own record of upcoming
// income. Deliberately has no invoicing/payment-link/Stripe fields, ever —
// unlike Milestone, this never claims Stripe/CSV-grade verification, so
// self-reporting it "received" (below) doesn't compromise any existing trust
// boundary the way reusing Milestone.status would have.
model ExpectedPayment {
  id                    String   @id @default(uuid())
  userId                String
  amount                Decimal  @db.Decimal(12, 2)
  // Both nullable — only amount and expectedDate are actually required.
  // Display code must always fall back (never assume clientName is set):
  // see today-facts.ts's UpcomingItem.label and markReceived()'s Transaction
  // description.
  clientName            String?
  projectName           String?
  // Which of the user's activities this payment belongs to — only meaningful
  // (and only ever asked for) when the user's tax profile activityType is
  // "mixed" (Tax & Contributions spec section 5): a single flat percentage
  // would be dishonest for a mixed-activity freelancer, so each payment must
  // identify its own activity instead of inheriting one blended guess.
  activityType          String?
  expectedDate          DateTime
  status                String   @default("pending") // "pending" | "received" | "cancelled"
  receivedTransactionId String?  @unique // set when marked received — links to the real Transaction created
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  receivedTransaction Transaction? @relation(fields: [receivedTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("expected_payments")
}
