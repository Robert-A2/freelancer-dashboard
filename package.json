{
  "name": "freelancer-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:i18n && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:merchants": "tsx scripts/seed-static-merchants.ts",
    "db:seed:relationships": "tsx scripts/seed-merchant-relationships.ts",
    "report:uncategorized": "tsx scripts/uncategorized-report.ts",
    "report:merchant-intelligence": "tsx scripts/merchant-intelligence-report.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.106.1",
    "next": "^15.1.0",
    "next-intl": "^4.13.0",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.0",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
